{
    "manifest_version": 3,
    "name": "Etsy AI Assistant",
    "version": "1.6.26",
    "description": "AI assistant integrated into Etsy pages",
    "permissions": [
        "scripting",
        "activeTab",
        "tabs",
        "storage",
        "unlimitedStorage",
        "downloads",
        "alarms",
        "offscreen"
    ],
    "host_permissions": [
        "https://www.etsy.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://openrouter.ai/*",
        "https://raw.githubusercontent.com/Bl0ck154/ChromeExtensionEtsyAI/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "background": {
        "service_worker": "background/service_worker.js"
    },
    "options_page": "options/options.html",
    "content_scripts": [
        {
            "matches": [
                "https://www.etsy.com/*"
            ],
            "js": [
                "content/inject_interceptor.js",
                "config/base_instruction.js",
                "content/config.js",
                "libs/Readability.min.js",
                "libs/turndown.js",
                "content/page_parser.js",
                "content/agent_policy_manager.js",
                "content/gemini_auxiliary_service.js",
                "content/agent_auxiliary_prompt_guard.js",
                "content/shop_intelligence_manager.js",
                "content/image_intelligence_manager.js",
                "content/agent_vision_metadata_guard.js",
                "content/etsy_context_interceptor.js",
                "content/link_discovery.js",
                "content/listing_editor_tracker.js",
                "content/memory_manager.js",
                "content/conversation_context_manager.js",
                "content/quick_reply_manager.js",
                "content/quick_reply_ui.js",
                "content/base_ai_service.js",
                "content/agent_context_manager.js",
                "content/providers/gemini_service.js",
                "content/providers/deepseek_service.js",
                "content/providers/grok_service.js",
                "content/providers/openrouter_service.js",
                "content/providers/custom_openai_service.js",
                "content/ai_service_factory.js",
                "content/agent_management_gate.js",
                "content/image_modal.js",
                "content/chat_manager.js",
                "content/content.js",
                "content/agent_scope_guard.js",
                "content/agent_ai_budget_guard.js",
                "content/agent_output_guard.js",
                "content/chat_ui.js",
                "content/chat_submission_guard.js"
            ],
            "css": [
                "content/chat_ui.css",
                "content/image_modal.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content/chat_ui.css",
                "content/ui.html",
                "config/agent_policy.json",
                "config/base_instruction.js",
                "content/page_interceptor.js"
            ],
            "matches": [
                "https://www.etsy.com/*"
            ]
        }
    ]
}
