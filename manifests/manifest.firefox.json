{
    "manifest_version": 3,
    "name": "Etsy AI Assistant",
    "version": "1.6.5",
    "description": "AI assistant integrated into Etsy pages",
    "permissions": [
        "scripting",
        "activeTab",
        "tabs",
        "storage",
        "downloads",
        "alarms"
    ],
    "host_permissions": [
        "https://www.etsy.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://openrouter.ai/*",
        "https://raw.githubusercontent.com/Bl0ck154/ChromeExtensionEtsyAI/*"
    ],
    "background": {
        "scripts": [
            "background/service_worker.js"
        ]
    },
    "options_page": "options/options.html",
    "content_scripts": [
        {
            "matches": [
                "https://www.etsy.com/*"
            ],
            "js": [
                "content/inject_interceptor.js",
                "config/base_instruction.js",
                "content/config.js",
                "libs/Readability.min.js",
                "libs/turndown.js",
                "content/page_parser.js",
                "content/agent_policy_manager.js",
                "content/shop_intelligence_manager.js",
                "content/image_intelligence_manager.js",
                "content/etsy_context_interceptor.js",
                "content/link_discovery.js",
                "content/listing_editor_tracker.js",
                "content/memory_manager.js",
                "content/base_ai_service.js",
                "content/providers/gemini_service.js",
                "content/providers/deepseek_service.js",
                "content/providers/grok_service.js",
                "content/providers/openrouter_service.js",
                "content/ai_service_factory.js",
                "content/image_modal.js",
                "content/chat_manager.js",
                "content/content.js",
                "content/chat_ui.js"
            ],
            "css": [
                "content/chat_ui.css",
                "content/image_modal.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content/chat_ui.css",
                "content/ui.html",
                "config/agent_policy.json",
                "config/base_instruction.js",
                "content/page_interceptor.js"
            ],
            "matches": [
                "https://www.etsy.com/*"
            ]
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "etsy-ai-assistant@bl0ck154.dev",
            "strict_min_version": "109.0"
        }
    }
}
